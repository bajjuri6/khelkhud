generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ATHLETE
  /// Village-level validator: a PET teacher, sarpanch, or similar publicly visible
  /// villager. Anything they raise is validated on arrival because they ARE the validator.
  COORDINATOR
  SPONSOR
  /// Sporting-goods manufacturer, distributor or retailer. CRUDs its own catalogue once an
  /// admin grants permission.
  SUPPLIER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  INFO_REQUESTED
}

enum SponsorType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
}

enum AthleteCategory {
  UNDER_12
  UNDER_15
  UNDER_19
  SENIOR
  PARA
}

enum ExperienceLevel {
  BEGINNER
  DISTRICT
  STATE
  NATIONAL
  INTERNATIONAL
}

enum SponsorshipStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UtilizationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AllocationStatus {
  PLANNED
  PURCHASED
  COMPLETED
}

enum DocumentKind {
  ID_PROOF
  ACHIEVEMENT_PROOF
  RECEIPT
  UPDATE_MEDIA
  PROFILE_PHOTO
  OTHER
}

enum NotificationType {
  SPONSORSHIP_RECEIVED
  ATHLETE_UPDATE
  VERIFICATION_RESULT
  PAYMENT_CONFIRMED
  INFO_REQUESTED
  /// A request needs validating. Goes to the village coordinator, or to admins when the
  /// village has none - see orphanedRequestQueue in coordinator.service.ts.
  REQUEST_SUBMITTED
  SYSTEM
}

enum TransactionType {
  SPONSORSHIP_PAYMENT
  REFUND
}

enum LocationLevel {
  STATE
  DISTRICT
  /// Sub-district. "Mandal" in Telangana/AP; tehsil or block elsewhere.
  MANDAL
  VILLAGE
  CITY
}

/// Where a Location row came from. Drives how much it can be trusted and what still needs
/// reconciling against the government directory.
enum LocationSource {
  /// Local Government Directory - the authoritative government registry.
  LGD
  /// India Post. A branch post office is almost always sited in a village and named after
  /// it, which makes it a good proxy - but it is a proxy, and carries no LGD code.
  INDIA_POST
  /// Added by a coordinator or admin because the datasets missed it. A dataset gap must
  /// never block a real athlete; these are queued for reconciliation.
  MANUAL
}

// ---------- Core ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleSub String?  @unique
  /// scrypt hash, format: scrypt$N$r$p$<salt-b64>$<key-b64>. Null for Google-only accounts.
  /// Never selected into an API response — see routes/auth.ts.
  passwordHash String?
  name      String
  avatarUrl String?
  role      Role?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile     AthleteProfile?
  sponsorProfile     SponsorProfile?
  coordinatorProfile CoordinatorProfile? @relation("CoordinatorUser")

  coordinatorsAppointed CoordinatorProfile[] @relation("CoordinatorAppointer")
  institutionsCustodied Institution[]        @relation("InstitutionCustodian")
  requestsRaised        Request[]            @relation("RequestRaiser")

  notifications  Notification[]
  documents      Document[]           @relation("UploadedDocuments")
  verifications  VerificationRecord[] @relation("Reviewer")

  @@index([role])
}

model Location {
  id       String        @id @default(cuid())
  name     String
  level    LocationLevel
  parentId String?
  lat      Float?
  lng      Float?

  /// Government identifier. Survives renames and boundary changes, and is the key every
  /// official scheme uses - which is why it is the anchor even when null for now.
  lgdCode  String?       @unique
  /// The narrowing key for village resolution: PIN first, fuzzy name second.
  pincode  String?
  /// Alternate and historical spellings, matched alongside `name`. Villages genuinely have
  /// several; without this the same place gets created twice.
  aliases  String[]      @default([])
  /// Denormalised "Ammapur, Dubbak, Medak, Telangana" so a village renders without
  /// walking four levels of the tree.
  displayPath String?
  source      LocationSource @default(MANUAL)
  /// False until reconciled against LGD. Unverified rows are still usable; the resolver
  /// just ranks them below canonical ones.
  isVerified  Boolean        @default(false)

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")

  athleteProfiles AthleteProfile[]
  sponsorProfiles SponsorProfile[]
  institutions    Institution[]
  requests        Request[]
  coordinators    CoordinatorProfile[] @relation("CoordinatorVillages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, level, parentId])
  @@index([parentId])
  @@index([level])
  @@index([pincode])
  @@index([level, pincode])
}

model Sport {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  iconKey  String?
  isActive Boolean @default(true)

  athleteProfiles AthleteProfile[]
  preferredBy    SponsorProfile[] @relation("PreferredSports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Profiles ----------

model AthleteProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  sportId         String?
  locationId      String?
  dateOfBirth     DateTime?
  category        AthleteCategory?
  experienceLevel ExperienceLevel?
  bio             String?
  photoKey        String?
  // Private: never exposed in public API responses
  coachName       String?
  coachContact    String?
  academyName     String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  user     User      @relation(fields: [userId], references: [id])
  sport    Sport?    @relation(fields: [sportId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  achievements        Achievement[]
  events              Event[]
  requests            Request[]
  sponsorships        Sponsorship[]
  updates             SponsorshipUpdate[]
  documents           Document[]
  verificationRecords VerificationRecord[]     @relation("AthleteVerifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId, verificationStatus])
  @@index([locationId])
  @@index([category])
}

model SponsorProfile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  sponsorType          SponsorType @default(INDIVIDUAL)
  displayName          String?
  orgName              String?
  locationId           String?
  bio                  String?
  isAnonymousByDefault Boolean     @default(false)

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  user            User      @relation(fields: [userId], references: [id])
  location        Location? @relation(fields: [locationId], references: [id])
  preferredSports Sport[]   @relation("PreferredSports")

  sponsorships        Sponsorship[]
  documents           Document[]
  verificationRecords VerificationRecord[] @relation("SponsorVerifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A village-level validator. The trust anchor of the whole model: verification cannot be
/// centralised across thousands of villages, and a PET teacher or sarpanch can judge
/// whether a claimed district medal is real in a way a remote reviewer cannot.
model CoordinatorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  /// Shown to sponsors so they can judge the vouching: "PET teacher, ZPHS Ammapur".
  designation String
  phone       String?
  /// This is a delegation of trust, so who granted it is recorded.
  appointedById String
  isActive      Boolean @default(true)

  user        User       @relation("CoordinatorUser", fields: [userId], references: [id])
  appointedBy User       @relation("CoordinatorAppointer", fields: [appointedById], references: [id])
  /// One person routinely covers several small villages, so this is many-to-many rather
  /// than a single FK. It is also the boundary of their authority - they cannot act
  /// outside it, structurally rather than by policy.
  villages    Location[] @relation("CoordinatorVillages")

  requestsValidated Request[] @relation("RequestValidator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum InstitutionKind {
  SCHOOL
  PLAYGROUND
  CLUB
  ANGANWADI
  OTHER
}

/// A shared beneficiary. v1 could only express "an athlete needs X"; most village needs are
/// "the school needs mats" or "the ground needs posts".
model Institution {
  id          String          @id @default(cuid())
  villageId   String
  kind        InstitutionKind
  name        String
  description String?
  custodianId String?

  village   Location @relation(fields: [villageId], references: [id])
  custodian User?    @relation("InstitutionCustodian", fields: [custodianId], references: [id])
  requests  Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId])
}

// ---------- Athlete content ----------

model Achievement {
  id              String           @id @default(cuid())
  athleteId        String
  title           String
  level           ExperienceLevel?
  year            Int?
  description     String?
  proofDocumentId String?

  athlete AthleteProfile @relation(fields: [athleteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
}

model Event {
  id                    String    @id @default(cuid())
  athleteId              String
  name                  String
  date                  DateTime?
  venue                 String?
  result                String?
  estimatedExpensePaise Int?
  isUpcoming            Boolean   @default(true)

  athlete AthleteProfile @relation(fields: [athleteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, date])
}

// ---------- Sponsorship ----------

enum RequestKind {
  /// Fulfilled in kind: a sponsor buys the item and ships it. khelkhud never touches the
  /// money on this track - see docs/architecture/v2-village-model.md section 4.
  EQUIPMENT
  /// Fulfilled in money, through Razorpay, with receipts. The v1 flow.
  CASH
}

enum RequestStatus {
  DRAFT
  /// Raised by an athlete, waiting on their village coordinator. Never waits on an admin.
  PENDING_VALIDATION
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  REJECTED
}

/// Generalises v1's SponsorshipRequirement. A need, raised in a village, for either an
/// athlete or an institution, met with either equipment or cash.
model Request {
  id            String        @id @default(cuid())
  kind          RequestKind
  /// Denormalised from the beneficiary so the sponsor notification fan-out is one indexed
  /// query rather than a join through two optional relations.
  villageId     String
  /// Exactly one of these is set - enforced in the service layer, since Prisma cannot
  /// express a check constraint.
  athleteId     String?
  institutionId String?
  raisedById    String

  title       String
  description String?
  status      RequestStatus @default(DRAFT)
  deadline    DateTime?

  /// Set the moment a coordinator raises it: they are the validator, so there is no queue.
  validatedById String?
  validatedAt   DateTime?
  rejectionNote String?

  totalEstimatedPaise Int @default(0)
  raisedAmountPaise   Int @default(0)

  village     Location            @relation(fields: [villageId], references: [id])
  athlete     AthleteProfile?     @relation(fields: [athleteId], references: [id])
  institution Institution?        @relation(fields: [institutionId], references: [id])
  raisedBy    User                @relation("RequestRaiser", fields: [raisedById], references: [id])
  validatedBy CoordinatorProfile? @relation("RequestValidator", fields: [validatedById], references: [id])

  items        RequestItem[]
  sponsorships Sponsorship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageId, status])
  @@index([athleteId, status])
  @@index([institutionId, status])
  @@index([status, kind])
}

/// One line of a request. For CASH this is a label and an amount. For EQUIPMENT it will
/// also carry a catalogue reference (added in step 4, deliberately not stubbed here).
model RequestItem {
  id             String @id @default(cuid())
  requestId      String
  label          String
  quantity       Int    @default(1)
  estimatedPaise Int
  fulfilledQty   Int    @default(0)
  note           String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model Sponsorship {
  id            String  @id @default(cuid())
  code          String  @unique
  sponsorId     String
  athleteId      String
  requestId     String?
  amountPaise   Int
  purpose       String
  isAnonymous   Boolean @default(false)

  status            SponsorshipStatus @default(ACTIVE)
  paymentStatus     PaymentStatus     @default(CREATED)
  utilizationStatus UtilizationStatus @default(NOT_STARTED)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  sponsor     SponsorProfile          @relation(fields: [sponsorId], references: [id])
  athlete      AthleteProfile           @relation(fields: [athleteId], references: [id])
  request     Request?                @relation(fields: [requestId], references: [id])

  allocations  SponsorshipAllocation[]
  updates      SponsorshipUpdate[]
  documents    Document[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sponsorId, status])
  @@index([athleteId, status])
  @@index([paymentStatus])
}

model SponsorshipAllocation {
  id                String           @id @default(cuid())
  sponsorshipId     String
  label             String
  amountPaise       Int
  status            AllocationStatus @default(PLANNED)
  receiptDocumentId String?
  note              String?
  completedAt       DateTime?

  sponsorship Sponsorship @relation(fields: [sponsorshipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sponsorshipId])
}

model SponsorshipUpdate {
  id            String  @id @default(cuid())
  athleteId      String
  /// Null = general profile update visible to everyone; set = linked to one sponsorship
  sponsorshipId String?
  title         String
  body          String

  athlete      AthleteProfile @relation(fields: [athleteId], references: [id])
  sponsorship Sponsorship?  @relation(fields: [sponsorshipId], references: [id])
  attachments Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, createdAt])
  @@index([sponsorshipId])
}

// ---------- Attachments ----------

model Document {
  id             String       @id @default(cuid())
  kind           DocumentKind
  storageKey     String       @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploaderUserId String

  athleteProfileId  String?
  sponsorProfileId String?
  sponsorshipId    String?
  updateId         String?

  uploader       User               @relation("UploadedDocuments", fields: [uploaderUserId], references: [id])
  athleteProfile  AthleteProfile?     @relation(fields: [athleteProfileId], references: [id])
  sponsorProfile SponsorProfile?    @relation(fields: [sponsorProfileId], references: [id])
  sponsorship    Sponsorship?       @relation(fields: [sponsorshipId], references: [id])
  update         SponsorshipUpdate? @relation(fields: [updateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteProfileId])
  @@index([sponsorProfileId])
  @@index([sponsorshipId])
  @@index([updateId])
  @@index([uploaderUserId])
}

// ---------- Ops ----------

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  body     String
  linkUrl  String?
  readAt   DateTime?
  emailedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model VerificationRecord {
  id               String             @id @default(cuid())
  subjectAthleteId  String?
  subjectSponsorId String?
  reviewerUserId   String
  decision         VerificationStatus
  note             String?

  subjectAthlete  AthleteProfile?  @relation("AthleteVerifications", fields: [subjectAthleteId], references: [id])
  subjectSponsor SponsorProfile? @relation("SponsorVerifications", fields: [subjectSponsorId], references: [id])
  reviewer       User            @relation("Reviewer", fields: [reviewerUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([subjectAthleteId])
  @@index([subjectSponsorId])
}

model Transaction {
  id                String          @id @default(cuid())
  sponsorshipId     String
  type              TransactionType @default(SPONSORSHIP_PAYMENT)
  amountPaise       Int
  currency          String          @default("INR")
  provider          String          @default("RAZORPAY")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  status            PaymentStatus
  rawPayload        Json?
  occurredAt        DateTime        @default(now())

  sponsorship Sponsorship @relation(fields: [sponsorshipId], references: [id])

  createdAt DateTime @default(now())

  @@unique([providerPaymentId])
  @@index([sponsorshipId])
}
