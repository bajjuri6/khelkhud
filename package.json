{
  "name": "khelkhud",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:up": "./devops/run-dev.sh",
    "dev:stop": "./devops/run-dev.sh stop",
    "dev:restart": "./devops/run-dev.sh restart",
    "dev:status": "./devops/run-dev.sh status",
    "local": "./devops/run-local.sh",
    "local:down": "./devops/run-local.sh down",
    "brand:images": "tsx devops/generate-brand-images.ts",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @khelkhud/api db:migrate",
    "db:seed": "pnpm --filter @khelkhud/api db:seed",
    "db:studio": "pnpm --filter @khelkhud/api db:studio"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "tsx": "^4.23.12",
    "turbo": "^2.5.4"
  }
}
