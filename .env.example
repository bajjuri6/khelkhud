# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/khelkhud

# --- Servers ---
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ---
# Generate with: openssl rand -hex 32  (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the ADMIN role on login
ADMIN_EMAILS=bajjuri6@gmail.com

# --- Payments (Razorpay test mode; leave blank to run in stub mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage (local | s3) ---
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email (SES; leave AWS creds blank to log emails to console) ---
MAIL_FROM=no-reply@khelkhud.example

# --- Brand image generation (local tooling only; not needed to run the app) ---
# Azure OpenAI, used by `pnpm brand:images` to regenerate apps/web/public/brand/*.
# Fetch with:
#   az cognitiveservices account show -n palla-m78m2ltj-swedencentral \
#     -g rg-pallav-2204_ai --query properties.endpoint -o tsv
#   az cognitiveservices account keys list -n palla-m78m2ltj-swedencentral \
#     -g rg-pallav-2204_ai --query key1 -o tsv
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# dall-e-3 is deprecated service-wide (HTTP 410). Use a gpt-image-* deployment.
AZURE_OPENAI_IMAGE_MODEL=gpt-image-2
