# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khelkhud

# --- Servers ---
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ---
# Generate with: openssl rand -hex 32  (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the ADMIN role on login
ADMIN_EMAILS=bajjuri6@gmail.com

# --- Payments (Razorpay test mode; leave blank to run in stub mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage (local | s3) ---
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email (SES; leave AWS creds blank to log emails to console) ---
MAIL_FROM=no-reply@khelkhud.example
