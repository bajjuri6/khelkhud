# syntax=docker/dockerfile:1.7
#
# khelkhud web — Next.js 15 (App Router), served by the standalone server.
#
# Built for a single architecture, not multi-arch: the VM is ARM (Standard_B2pls_v2) and
# the only build machine is an Apple Silicon Mac, so linux/arm64 is native both ends. See
# BUILD_PLATFORM in devops/_lib.sh before changing either half of that pair.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
# deps — every workspace manifest first, so a source-only change reuses this layer.
# All of them are copied even though only web's subtree is installed: pnpm validates the
# lockfile against every importer it declares, and a missing manifest fails the install
# with ERR_PNPM_OUTDATED_LOCKFILE rather than being ignored.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json      ./apps/web/
COPY apps/api/package.json      ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/theme/package.json  ./packages/theme/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@khelkhud/web..."

# ---------------------------------------------------------------------------
# builder
# ---------------------------------------------------------------------------
FROM base AS builder
COPY --from=deps /repo/node_modules                 ./node_modules
COPY --from=deps /repo/apps/web/node_modules        ./apps/web/node_modules
COPY --from=deps /repo/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /repo/packages/theme/node_modules  ./packages/theme/node_modules
COPY . .

# NEXT_PUBLIC_* values are inlined into the client bundle at build time and CANNOT be
# changed at container runtime.
#
# NEXT_PUBLIC_API_URL defaults to EMPTY on purpose. Caddy serves the API at /api/* on the
# same origin as the site, so the browser should send relative URLs. Note the difference
# between empty and unset: lib/api.ts uses `?? "http://localhost:4000"`, which an empty
# string satisfies but an unset variable does not — leave this unset and every production
# browser will try to call localhost.
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_SITE_URL="https://khelkhud.org"
ARG NEXT_PUBLIC_INDEXABLE="true"
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_INDEXABLE=${NEXT_PUBLIC_INDEXABLE} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

# The theme's CSS is generated from tokens.ts, and globals.css imports it. Without this
# the Tailwind build resolves an empty file and every brand utility silently vanishes.
RUN pnpm --filter @khelkhud/theme build
RUN pnpm --filter @khelkhud/web exec next build

# ---------------------------------------------------------------------------
# runner
# ---------------------------------------------------------------------------
FROM node:22-slim AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r app && useradd -r -g app app

WORKDIR /app

# Two path facts, both easy to get wrong:
#   1. `.next` is emitted under apps/web/, NOT at the tracing root. outputFileTracingRoot
#      changes the layout INSIDE the standalone bundle, not where .next is written.
#   2. Because that tracing root is the monorepo root, the bundle preserves the workspace
#      layout — so the entrypoint is apps/web/server.js, and node_modules/ and packages/
#      sit beside it at the top level.
# Verified layout: standalone/{apps/web/server.js, node_modules, packages, package.json}
COPY --from=builder --chown=app:app /repo/apps/web/.next/standalone  ./
COPY --from=builder --chown=app:app /repo/apps/web/.next/static      ./apps/web/.next/static
COPY --from=builder --chown=app:app /repo/apps/web/public            ./apps/web/public

USER app
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=4s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:3000/ >/dev/null || exit 1

CMD ["node", "apps/web/server.js"]
