# syntax=docker/dockerfile:1.7
#
# khelkhud api — Express 5 + Prisma 6.
#
# The API has no compile step: its `build` script is `tsc --noEmit` and `start` is
# `tsx src/index.ts`. So the runtime image ships the TypeScript sources and tsx rather
# than a dist/ folder, and dev dependencies are NOT pruned — tsx is one of them. That is a
# deliberate trade: adding a real tsc emit step would mean rewriting the ESM `.js` import
# specifiers the source already uses, for a couple of hundred MB.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# openssl is a hard requirement for Prisma's query engine, and node:22-slim omits it.
# Without it the client throws at boot with a libssl error that names no obvious cause.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
# deps — see Dockerfile.web for why every workspace manifest is copied.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json      ./apps/api/
COPY apps/web/package.json      ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/theme/package.json  ./packages/theme/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@khelkhud/api..."

# ---------------------------------------------------------------------------
# runner
# ---------------------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production \
    API_PORT=4000

COPY --from=deps /repo/node_modules                 ./node_modules
COPY --from=deps /repo/apps/api/node_modules        ./apps/api/node_modules
COPY --from=deps /repo/packages/shared/node_modules ./packages/shared/node_modules

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared ./packages/shared
COPY apps/api        ./apps/api

# Generate the Prisma client for THIS image's platform. Doing it here rather than copying
# a generated client from a build stage is what keeps the arm64 engine binary correct.
RUN pnpm --filter @khelkhud/api exec prisma generate

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r app && useradd -r -g app app \
 && mkdir -p /repo/apps/api/uploads \
 && chown -R app:app /repo/apps/api/uploads

# STORAGE_DRIVER=local writes here (providers/storage/local.ts resolves apps/api/uploads).
# compose mounts a named volume over it — without that, every deploy silently discards
# every receipt and profile photo the athletes uploaded.
VOLUME ["/repo/apps/api/uploads"]

USER app
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:4000/api/health >/dev/null || exit 1

# Invoke tsx DIRECTLY rather than through `pnpm --filter @khelkhud/api start`.
#
# Going through pnpm makes corepack try to provision the pinned pnpm version at container
# start, into $HOME/.cache — and `app` is a system user whose home does not exist and is
# not writable, so the container dies immediately with
# `EACCES: permission denied, mkdir '/home/app/.cache/node/corepack/v1'`.
# Baking a corepack cache in would work too, but a package manager has no business being
# in the runtime path of a production process at all.
#
# This is exactly `apps/api/package.json`'s `start` script, minus the indirection.
CMD ["apps/api/node_modules/.bin/tsx", "apps/api/src/index.ts"]
